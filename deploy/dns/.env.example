# Copy this file to .env on each DNS node. Never commit the real file.
DNS_DB_PASSWORD=replace-with-a-long-random-password
DNS_API_KEY=replace-with-a-long-random-api-key

# Public addresses must belong to two separate servers/networks.
PRIMARY_PUBLIC_IP=203.0.113.10
SECONDARY_PUBLIC_IP=198.51.100.20

# Primary only: bind API to the node's private/VPN address when the backend is remote.
DNS_API_BIND_ADDRESS=127.0.0.1
BACKEND_PRIVATE_CIDR=10.0.0.20/32
DNS_LISTEN_ADDRESS=0.0.0.0

AUTHORITATIVE_ZONE=vexirahost.com
NS1_HOST=ns1.vexirahost.com
NS2_HOST=ns2.vexirahost.com
