# Vexira Host — Backend Environment Template
# Copy to .env and fill in values. Never commit secrets.
# Canlı URL-lər: ../../deploy/URLS.env
# Production şablon: .env.production.example

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Vexira Host
# Local:
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000/api/v1
# Production:
# APP_URL=https://vexirahost.com
# API_URL=https://api.vexirahost.com
# API_PUBLIC_URL=https://api.vexirahost.com/api/v1
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=https://vexirahost.com,https://www.vexirahost.com
LOG_LEVEL=debug

# Local development only. Production start fails when this is true.
DEPLOY_MOCK_REMOTE=false

# ─── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:1234@localhost:5432/vexira_host?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── JWT / Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# First-time local admin only. Never overwrites an existing admin password.
# ADMIN_SEED_PASSWORD=

# ─── Storage ───────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_R2_BUCKET=
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY=
STORAGE_R2_SECRET_KEY=

# ─── OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_CALLBACK_URL=https://api.vexirahost.com/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional fallbacks if not set in Admin → System (database overrides these).
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
# GITHUB_CALLBACK_URL=https://api.vexirahost.com/api/v1/auth/github/callback
GITHUB_DEPLOY_CALLBACK_URL=http://localhost:4000/api/v1/deploy/github/oauth/callback
# GITHUB_DEPLOY_CALLBACK_URL=https://api.vexirahost.com/api/v1/deploy/github/oauth/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
# FRONTEND_AUTH_CALLBACK_URL=https://vexirahost.com/auth/callback

# ─── SMTP / Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Domain Registrar ────────────────────────────────────────────
REGISTRAR_PROVIDER=mock
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_CONTACT_ID=
NAMESILO_DEFAULT_NAMESERVERS=ns1.vexirahost.com,ns2.vexirahost.com

# ─── Cloudflare DNS ─────────────────────────────────────────────
# API token permissions: Zone:Read, DNS:Edit. Zone:Edit is also
# required when Vexira should create missing zones automatically.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# ─── Vexira authoritative DNS (ns1/ns2) ─────────────────────────
# The API must point to the PowerDNS primary/control node. Keep port 8081
# private (firewall/VPN); the public authoritative service uses TCP/UDP 53.
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_SERVER_ID=localhost
AUTHORITATIVE_NAMESERVERS=ns1.vexirahost.com,ns2.vexirahost.com
POWERDNS_MONITOR_DOMAIN=vexirahost.com

# ─── Proxmox / VPS ───────────────────────────────────────────────
PROXMOX_PROVIDER=mock
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_DEFAULT_NODE=pve-fra-01

# ─── Hosting credentials encryption ─────────────────────────────
HOSTING_CREDENTIALS_KEY=change-me-hosting-encryption-key-min-32-chars

# ─── Payments (Kapital Bank Ecommerce) ──────────────────────────
# mock = instant fake charge (no bank) | kapital = HPP redirect
PAYMENT_PROVIDER=kapital
KAPITAL_USERNAME=
KAPITAL_PASSWORD=
# true = txpgtst.kapitalbank.az | false = e-commerce.kapitalbank.az
# Admin panel (/t4abriz/panel/system) test/production seçimi DB-də saxlanır və .env-dən üstündür.
KAPITAL_IS_DEV=true
# URL admin panel ortamından avtomatik gəlir — KAPITAL_BASE_URL istifadə olunmur.
# Local: localhost callbacks OK for HPP return on same machine.
# Production: use public HTTPS API + frontend URLs (see deploy/URLS.env).
KAPITAL_REDIRECT_URL=http://localhost:4000/api/v1/payments/kapital/callback
KAPITAL_RETURN_URL=http://localhost:3000/payment/result
# KAPITAL_REDIRECT_URL=https://api.vexirahost.com/api/v1/payments/kapital/callback
# KAPITAL_RETURN_URL=https://vexirahost.com/payment/result
KAPITAL_LANGUAGE=az

# ─── Payments (Epoint recurring / saved card) ───────────────────
# Epoint kabinetində result_url olaraq bu ünvanı qeyd edin:
# https://api.vexirahost.com/api/v1/payments/epoint/callback
# PAYMENT_PROVIDER=epoint olduqda birdəfəlik checkout da Epoint-ə yönləndirilir.
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_BASE_URL=https://epoint.az/api/1
EPOINT_RETURN_URL=http://localhost:3000/payment/result
EPOINT_CARD_RETURN_URL=http://localhost:3000/dashboard/payments
EPOINT_RESULT_URL=http://localhost:4000/api/v1/payments/epoint/callback
# Only for a local Epoint-compatible sandbox. Never enable in production.
EPOINT_ALLOW_INSECURE=false
# EPOINT_RETURN_URL=https://vexirahost.com/payment/result
EPOINT_LANGUAGE=az

# ─── Staff WhatsApp alerts ──────────────────────────────────────
# Optional extra E.164 numbers (comma-separated). All ACTIVE ADMIN users
# with a phone and WhatsApp notifications enabled are notified automatically.
STAFF_WHATSAPP_NOTIFY_PHONES=
PROXMOX_PROVIDER=mock
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_DEFAULT_NODE=pve-fra-01
PROXMOX_DEFAULT_TEMPLATE_VMID=
PROXMOX_STORAGE=local-lvm
PROXMOX_DISK=scsi0
PROXMOX_TASK_TIMEOUT_MS=600000
PROXMOX_REGION_NODES={"fra-01":"pve-fra-01"}
PROXMOX_TEMPLATES={"ubuntu-22.04":"9000"}
