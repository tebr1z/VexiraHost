generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id                           String     @id @default(cuid())
  email                        String     @unique
  passwordHash                 String?
  firstName                    String?
  lastName                     String?
  role                         UserRole   @default(CUSTOMER)
  status                       UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt              DateTime?
  preferredCurrency            String?
  billingPeriod                String?
  currencyChangedAt            DateTime?
  currencyLocked               Boolean    @default(false)
  /**
   * Saved invoice/billing address — reused on checkout after first entry.
   */
  billingAddress               Json?
  /**
   * Marketing / campaign emails — default opted in at registration.
   */
  marketingOptIn               Boolean    @default(true)
  marketingOptInAt             DateTime?
  unsubscribeToken             String?    @unique
  /**
   * Prepaid account credit used to pay invoices.
   */
  accountBalance               Decimal    @default(0) @db.Decimal(12, 2)
  balanceCurrency              String     @default("USD")
  /**
   * Last UI locales used for emails — newest first, max 3 (en/tr/ru/az).
   */
  localeHistory                String[]   @default([])
  /**
   * E.164-compatible contact number used for WhatsApp service notifications.
   */
  phone                        String?
  whatsappNotificationsEnabled Boolean    @default(true)
  /**
   * When true, password login requires a one-time code emailed to the user.
   */
  emailTwoFactorEnabled        Boolean    @default(false)
  /**
   * Authenticator app (Google Authenticator, Authy, Microsoft Authenticator, etc.).
   */
  totpEnabled                  Boolean    @default(false)
  /** Base32 TOTP secret — set during setup; cleared when disabled. */
  totpSecret                   String?
  /**
   * Client (exit) IP from the most recent successful login.
   */
  lastLoginIp                  String?
  lastLoginAt                  DateTime?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailLoginOtps          EmailLoginOtp[]
  oauthAccounts           OAuthAccount[]
  domains                 Domain[]
  domainChangeRequests    DomainChangeRequest[]
  servers                 Server[]
  hostingAccounts         HostingAccount[]
  addonServices           AddonService[]
  orders                  Order[]
  invoices                Invoice[]
  paymentMethods          PaymentMethod[]
  payments                Payment[]
  tickets                 Ticket[]
  ticketMessages          TicketMessage[]
  ticketAttachments       TicketAttachment[]
  assignedTickets         Ticket[]                 @relation("AssignedTickets")
  promoRedemptions        PromoRedemption[]
  balanceTransactions     BalanceTransaction[]
  notifications           Notification[]
  whatsappApiAccess       WhatsappApiAccess?
  whatsappApiKeys         WhatsappApiKey[]
  whatsappApiUsages       WhatsappApiUsage[]

  @@map("users")
}

enum BalanceTxnType {
  ADMIN_CREDIT
  INVOICE_PAYMENT
  ADJUSTMENT
}

model BalanceTransaction {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal        @db.Decimal(12, 2)
  balanceAfter    Decimal        @db.Decimal(12, 2)
  currency        String
  type            BalanceTxnType
  referenceNumber String?        @unique
  note            String?
  invoiceId       String?
  adminId         String?
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([invoiceId])
  @@map("balance_transactions")
}

enum NotificationType {
  BALANCE_CREDIT
  BALANCE_PAYMENT
  INVOICE
  SERVICE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  reference String?
  href      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Campaign {
  id             String         @id @default(cuid())
  subject        String
  previewText    String?
  bodyHtml       String         @db.Text
  bodyText       String?        @db.Text
  status         CampaignStatus @default(DRAFT)
  sentAt         DateTime?
  recipientCount Int            @default(0)
  successCount   Int            @default(0)
  failCount      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@map("campaigns")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailLoginOtp {
  id             String    @id @default(cuid())
  codeHash       String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * LOGIN = password sign-in challenge
   * EMAIL_2FA = confirm enable/disable of email two-factor
   */
  purpose        String    @default("LOGIN")
  rememberMe     Boolean   @default(false)
  desiredEnabled Boolean?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([userId, purpose])
  @@map("email_login_otps")
}

model OAuthAccount {
  id         String        @id @default(cuid())
  provider   OAuthProvider
  providerId String
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

enum ProductCategory {
  DOMAIN
  HOSTING
  VPS
  DEDICATED
  LICENSE
  SSL
  EMAIL
  BACKUP
  WHATSAPP_API
}

enum DigitalDeliveryMode {
  NONE
  LICENSE_KEY
  FILE
  KEY_AND_FILE
  MANUAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

model CatalogCategory {
  id         String           @id @default(cuid())
  slug       String           @unique
  name       String
  /**
   * Localized labels: { "az": "...", "en": "...", "tr": "...", "ru": "..." }
   */
  names      Json?
  sortOrder  Int              @default(0)
  isActive   Boolean          @default(true)
  /**
   * Fulfillment type inherited by products in this category
   */
  systemType ProductCategory?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("catalog_categories")
}

model Product {
  id                      String              @id @default(cuid())
  slug                    String              @unique
  name                    String
  description             String?
  category                ProductCategory
  catalogCategoryId       String?
  catalogCategory         CatalogCategory?    @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)
  hostingPlanSlug         String?
  price                   Decimal             @db.Decimal(10, 2)
  currency                String              @default("USD")
  billingCycle            BillingCycle
  isActive                Boolean             @default(true)
  sortOrder               Int                 @default(0)
  /**
   * Digital delivery for LICENSE (and similar) products
   */
  deliveryMode            DigitalDeliveryMode @default(NONE)
  isFree                  Boolean             @default(false)
  /**
   * One activation key per line; consumed on provision when pool mode
   */
  licenseKeys             String?             @db.Text
  downloadUrl             String?
  downloadFileName        String?
  /**
   * App / product promo copy shown to customers
   */
  promoText               String?             @db.Text
  activationGuideText     String?             @db.Text
  activationGuideImageUrl String?
  activationGuideVideoUrl String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]
  prices       ProductPrice[]

  @@index([catalogCategoryId])
  @@map("products")
}

enum PriceCurrency {
  USD
  EUR
  AZN
}

enum PricePeriod {
  MONTHLY
  YEARLY
}

model ProductPrice {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency      PriceCurrency
  period        PricePeriod
  originalPrice Decimal       @db.Decimal(10, 2)
  salePrice     Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([productId, currency, period])
  @@index([productId])
  @@map("product_prices")
}

enum DomainStatus {
  PENDING
  ACTIVE
  TRANSFER_PENDING
  EXPIRED
  SUSPENDED
}

enum DomainManagementMode {
  REGISTRAR
  MANUAL
}

enum DomainChangeType {
  DNS
  NAMESERVER
}

enum DomainChangeStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum TransferStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
}

model Domain {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String               @unique
  tld              String
  status           DomainStatus         @default(PENDING)
  managementMode   DomainManagementMode @default(REGISTRAR)
  /**
   * Internal only — Natro, Hostinger, etc. Not shown to customers.
   */
  registrarSource  String?
  adminNotes       String?
  registrarRef     String?
  registeredAt     DateTime?
  expiresAt        DateTime?
  autoRenew        Boolean              @default(true)
  nameservers      String[]             @default([])
  /**
   * Glue records: [{ "host": "ns1.example.com", "ip": "1.2.3.4" }]
   */
  nsGlueRecords    Json                 @default("[]")
  billingAmount    Decimal?             @db.Decimal(10, 2)
  billingCurrency  String               @default("USD")
  graceEndsAt      DateTime?
  renewalInvoiceId String?
  expiredAt        DateTime?
  lateFeeAppliedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  dnsRecords         DnsRecord[]
  transfers          DomainTransfer[]
  changeRequests     DomainChangeRequest[]
  invoices           Invoice[]
  expiryReminders    DomainExpiryReminder[]

  @@index([userId])
  @@index([managementMode])
  @@index([expiresAt])
  @@index([graceEndsAt])
  @@map("domains")
}

enum DomainExpiryReminderKind {
  PRE_30
  PRE_20
  PRE_15
  PRE_10
  PRE_5
  PRE_3
  PRE_2
  PRE_1
  EXPIRED
  EXPIRED_7
  EXPIRED_10
  EXPIRED_15
  DELETED
}

model DomainExpiryReminder {
  id        String                   @id @default(cuid())
  domainId  String
  domain    Domain                   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  kind      DomainExpiryReminderKind
  sentAt    DateTime                 @default(now())

  @@unique([domainId, kind])
  @@index([domainId])
  @@map("domain_expiry_reminders")
}

model DnsRecord {
  id        String        @id @default(cuid())
  domainId  String
  domain    Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      DnsRecordType
  name      String
  value     String
  ttl       Int           @default(3600)
  priority  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([domainId])
  @@map("dns_records")
}

model DomainTransfer {
  id           String         @id @default(cuid())
  domainId     String
  domain       Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId       String
  authCodeHash String
  status       TransferStatus @default(INITIATED)
  registrarRef String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([domainId])
  @@index([userId])
  @@map("domain_transfers")
}

model DomainChangeRequest {
  id              String             @id @default(cuid())
  domainId        String
  domain          Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            DomainChangeType
  status          DomainChangeStatus @default(PENDING)
  previousData    Json
  requestedData   Json
  adminNotifiedAt DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([domainId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("domain_change_requests")
}

model TldPricing {
  id            String   @id @default(cuid())
  tld           String   @unique
  registerPrice Decimal  @db.Decimal(10, 2)
  renewPrice    Decimal  @db.Decimal(10, 2)
  transferPrice Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tld_pricing")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum ServerType {
  VPS
  DEDICATED
}

enum ServerStatus {
  PROVISIONING
  RUNNING
  STOPPED
  SUSPENDED
  ERROR
}

enum ServerPowerAction {
  START
  STOP
  REBOOT
  SHUTDOWN
}

model ServerPlan {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String?
  type          ServerType
  cpuCores      Int
  ramGb         Int
  diskGb        Int
  bandwidthGbps Decimal      @default(1.0) @db.Decimal(4, 2)
  price         Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  billingCycle  BillingCycle @default(MONTHLY)
  regions       String[]     @default(["fra-01", "nyc-01", "sin-01"])
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  servers Server[]

  @@map("server_plans")
}

model Server {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          ServerPlan   @relation(fields: [planId], references: [id])
  hostname      String       @unique
  displayName   String
  type          ServerType
  status        ServerStatus @default(PROVISIONING)
  region        String
  ipv4          String?
  osTemplate    String       @default("ubuntu-22.04")
  proxmoxVmId   String?
  proxmoxNode   String?
  cpuCores      Int
  ramGb         Int
  diskGb        Int
  provisionedAt DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  powerLogs ServerPowerLog[]

  @@index([userId])
  @@index([planId])
  @@index([expiresAt])
  @@map("servers")
}

model ServerPowerLog {
  id        String            @id @default(cuid())
  serverId  String
  server    Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  action    ServerPowerAction
  success   Boolean           @default(true)
  message   String?
  createdAt DateTime          @default(now())

  @@index([serverId])
  @@map("server_power_logs")
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketRelatedServiceType {
  HOSTING
  SERVER
  DOMAIN
  ADDON
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id                String            @id @default(cuid())
  code              String            @unique
  type              PromoDiscountType
  value             Decimal           @db.Decimal(10, 2)
  currency          PriceCurrency?
  maxDiscountAmount Decimal?          @db.Decimal(10, 2)
  minOrderAmount    Decimal?          @db.Decimal(10, 2)
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int?
  maxPerUser        Int?
  isActive          Boolean           @default(true)
  appliesToAll      Boolean           @default(true)
  productIds        String[]          @default([])
  categories        ProductCategory[] @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  redemptions PromoRedemption[]
  orders      Order[]

  @@index([isActive])
  @@map("promo_codes")
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal   @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())

  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_redemptions")
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  currency       String      @default("USD")
  promoCodeId    String?
  promoCodeRef   PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCode      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items           OrderItem[]
  invoices        Invoice[]
  hostingAccounts HostingAccount[]
  promoRedemption PromoRedemption?

  @@index([userId])
  @@index([promoCodeId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  productName String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Invoice {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  hostingAccountId String?
  hostingAccount   HostingAccount? @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)
  domainId         String?
  domain           Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  invoiceNumber    String          @unique
  status           InvoiceStatus   @default(OPEN)
  subtotal         Decimal         @db.Decimal(10, 2)
  total            Decimal         @db.Decimal(10, 2)
  currency         String          @default("USD")
  dueDate          DateTime
  /**
   * Idempotency marker for the one-day WhatsApp due reminder.
   */
  reminder1dSentAt DateTime?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([userId])
  @@index([orderId])
  @@index([hostingAccountId])
  @@index([domainId])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentMethod {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PaymentMethodType @default(CARD)
  label       String
  last4       String?
  brand       String?
  expiryMonth Int?
  expiryYear  Int?
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  payments Payment[]

  @@index([userId])
  @@map("payment_methods")
}

model Payment {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  methodId      String?
  method        PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("USD")
  status        PaymentStatus  @default(PENDING)
  gatewayRef    String?
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([invoiceId])
  @@map("payments")
}

model Ticket {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject             String
  status              TicketStatus              @default(OPEN)
  priority            TicketPriority            @default(MEDIUM)
  relatedServiceType  TicketRelatedServiceType?
  relatedServiceId    String?
  relatedServiceLabel String?
  /**
   * Client IP captured when the ticket was created.
   */
  clientIp            String?
  assignedToId        String?
  assignedTo          User?                     @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@index([userId])
  @@index([assignedToId])
  @@index([relatedServiceType, relatedServiceId])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String
  size       Int
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

enum ServiceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  FAILED
}

enum AddonServiceType {
  LICENSE
  SSL
  EMAIL
  BACKUP
  WHATSAPP_API
}

model AddonService {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AddonServiceType
  name          String
  identifier    String?
  status        ServiceStatus    @default(PROVISIONING)
  metadata      Json?
  expiresAt     DateTime?
  provisionedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@map("addon_services")
}

enum HostingPanel {
  CPANEL
  PLESK
}

enum HostingManagementMode {
  AUTOMATED
  MANUAL
}

enum ManualServiceCategory {
  HOSTING
  SERVER
}

model HostingServer {
  id               String       @id @default(cuid())
  name             String
  hostname         String
  ipAddress        String
  panel            HostingPanel
  whmUsername      String
  whmPasswordEnc   String
  apiTokenEnc      String?
  isDefault        Boolean      @default(false)
  isActive         Boolean      @default(true)
  maxAccounts      Int?
  accountCount     Int          @default(0)
  lastCheckedAt    DateTime?
  lastConnectionOk Boolean?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accounts  HostingAccount[]
  plans     HostingPlan[]
  planLinks HostingPlanServer[]

  @@map("hosting_servers")
}

enum HostingDistributionMode {
  FAILOVER
  BALANCED
}

model HostingPlan {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             String
  description      String?
  panel            HostingPanel
  diskGb           Int
  bandwidthGb      Int
  maxDomains       Int
  maxEmails        Int
  maxDatabases     Int
  price            Decimal                 @db.Decimal(10, 2)
  currency         String                  @default("USD")
  billingCycle     BillingCycle            @default(MONTHLY)
  isActive         Boolean                 @default(true)
  sortOrder        Int                     @default(0)
  /**
   * Primary / legacy single-server link (kept in sync with first planServers row).
   */
  serverId         String?
  pleskPlanName    String?
  /**
   * FAILOVER = fill servers in priority order; BALANCED = prefer least-loaded.
   */
  distributionMode HostingDistributionMode @default(FAILOVER)
  server           HostingServer?          @relation(fields: [serverId], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  accounts    HostingAccount[]
  planServers HostingPlanServer[]

  @@index([serverId])
  @@map("hosting_plans")
}

model HostingPlanServer {
  id        String        @id @default(cuid())
  planId    String
  plan      HostingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  serverId  String
  server    HostingServer @relation(fields: [serverId], references: [id], onDelete: Restrict)
  /**
   * Lower = earlier for FAILOVER mode.
   */
  priority  Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([planId, serverId])
  @@index([planId, priority])
  @@index([serverId])
  @@map("hosting_plan_servers")
}

model HostingAccount {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  plan                  HostingPlan            @relation(fields: [planId], references: [id])
  serverId              String?
  server                HostingServer?         @relation(fields: [serverId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  primaryDomain         String                 @unique
  username              String                 @unique
  panel                 HostingPanel
  managementMode        HostingManagementMode  @default(AUTOMATED)
  serviceCategory       ManualServiceCategory?
  status                ServiceStatus          @default(PROVISIONING)
  panelIp               String?
  panelUrl              String?
  panelUsername         String?
  panelPasswordEnc      String?
  panelRef              String?
  panelSessionTokenEnc  String?
  panelSessionExpiresAt DateTime?
  expiresAt             DateTime?
  billingAmount         Decimal?               @db.Decimal(10, 2)
  billingCurrency       String                 @default("USD")
  graceEndsAt           DateTime?
  renewalInvoiceId      String?
  provisionStage        String?
  provisionError        String?
  provisionedAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  invoices Invoice[]

  @@index([userId])
  @@index([planId])
  @@index([serverId])
  @@index([orderId])
  @@index([managementMode])
  @@index([serviceCategory])
  @@index([expiresAt])
  @@index([graceEndsAt])
  @@map("hosting_accounts")
}

model NavGroup {
  id        String    @id @default(cuid())
  key       String    @unique
  labels    Json
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  items     NavItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("nav_groups")
}

model NavItem {
  id        String   @id @default(cuid())
  groupId   String
  group     NavGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  labels    Json
  href      String
  pathMatch String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("nav_items")
}

enum CmsSectionType {
  HERO
  PLANS
  INCLUDED
  FEATURES
  FAQ
  CTA
  STATS
  RICH_TEXT
  BANNER
  CUSTOM
}

model CmsPage {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       Json
  parentSlug  String?
  pathSegment String?          @unique
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  sections    CmsPageSection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentSlug])
  @@map("cms_pages")
}

model CmsPageSection {
  id        String         @id @default(cuid())
  pageId    String
  page      CmsPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  type      CmsSectionType
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  content   Json
  design    Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([pageId, key])
  @@index([pageId])
  @@map("cms_page_sections")
}

enum WhatsappSessionStatus {
  DISCONNECTED
  QR_READY
  CONNECTING
  CONNECTED
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  FAILED
}

/**
 * Singleton row (id = "default") for the company WhatsApp linked-device session.
 */
model WhatsappSession {
  id              String                @id @default("default")
  status          WhatsappSessionStatus @default(DISCONNECTED)
  phoneNumber     String?
  displayName     String?
  lastQrAt        DateTime?
  lastConnectedAt DateTime?
  lastError       String?
  updatedAt       DateTime              @updatedAt
  createdAt       DateTime              @default(now())

  @@map("whatsapp_sessions")
}

/**
 * A linked WhatsApp number available to the outbound message pool.
 * The legacy singleton session is imported as the primary account.
 */
model WhatsappGatewayAccount {
  id              String                @id @default(cuid())
  label           String
  status          WhatsappSessionStatus @default(DISCONNECTED)
  phoneNumber     String?
  displayName     String?
  isEnabled       Boolean               @default(true)
  sentCount       Int                   @default(0)
  failedCount     Int                   @default(0)
  lastSentAt      DateTime?
  lastQrAt        DateTime?
  lastConnectedAt DateTime?
  lastError       String?
  updatedAt       DateTime              @updatedAt
  createdAt       DateTime              @default(now())

  messageLogs WhatsappMessageLog[]

  @@index([isEnabled, status, sentCount])
  @@map("whatsapp_gateway_accounts")
}

model WhatsappMessageLog {
  id        String                @id @default(cuid())
  toPhone   String
  userId    String?
  apiKeyId  String?
  apiKey    WhatsappApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  gatewayAccountId String?
  gatewayAccount   WhatsappGatewayAccount? @relation(fields: [gatewayAccountId], references: [id], onDelete: SetNull)
  body      String
  status    WhatsappMessageStatus @default(PENDING)
  error     String?
  createdAt DateTime              @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([apiKeyId])
  @@index([gatewayAccountId])
  @@map("whatsapp_message_logs")
}

/**
 * Admin-managed entitlement for use of the shared WhatsApp gateway.
 */
model WhatsappApiAccess {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled           Boolean  @default(false)
  monthlyLimit        Int      @default(0)
  /**
   * Admin-granted access outside the purchase flow (legacy/manual customers).
   */
  legacyManualAccess  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("whatsapp_api_access")
}

/**
 * Plaintext keys are shown once; only their SHA-256 hashes are persisted.
 */
model WhatsappApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastFour   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  messageLogs WhatsappMessageLog[]

  @@index([userId, isActive])
  @@map("whatsapp_api_keys")
}

/**
 * Atomic monthly usage counter; one row per customer and UTC month.
 */
model WhatsappApiUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, periodStart])
  @@index([periodStart])
  @@map("whatsapp_api_usage")
}
